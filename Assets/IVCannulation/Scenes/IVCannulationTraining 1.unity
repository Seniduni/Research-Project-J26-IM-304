--- !u!114 &1524933524
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1524933521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d0ef3eefce7f1fce4c43b4ac0abb73f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IVSim.IVSession
  participantId: P001
  writeCsvLogs: 1
  profiles:
  - level: 0
    label: Easy - Guided
    description: See-through skin, labelled veins, recommended sites, live angle
      gauge and side view.
    skinOpacity: 0.35
    showVeins: 1
    showVeinLabels: 1
    showSiteMarkers: 1
    liveAngleGauge: 1
    liveFeedback: 1
    showSideView: 1
    showAngleReference: 1
    enforceStepOrder: 1
    showHints: 1
    maxAttempts: 0
  - level: 1
    label: Medium - Assisted
    description: Veins faintly visible through the skin. Angle readout and feedback,
      no site markers.
    skinOpacity: 0.88
    showVeins: 1
    showVeinLabels: 0
    showSiteMarkers: 0
    liveAngleGauge: 1
    liveFeedback: 1
    showSideView: 0
    showAngleReference: 1
    enforceStepOrder: 1
    showHints: 1
    maxAttempts: 3
  - level: 2
    label: Hard - Assessment
    description: 'Opaque skin: find the vein by palpation. No live hints; feedback
      in the final report. Two attempts.'
    skinOpacity: 1
    showVeins: 0
    showVeinLabels: 0
    showSiteMarkers: 0
    liveAngleGauge: 0
    liveFeedback: 0
    showSideView: 0
    showAngleReference: 0
    enforceStepOrder: 0
    showHints: 0
    maxAttempts: 2
  menuPreview: 0
  clinical:
    idealAngleMin: 15
    idealAngleMax: 30
    acceptableAngleMin: 10
    acceptableAngleMax: 35
    bevelTolerance: 25
    lowerAngleBy: 4
    advanceAfterFlash: 0.0008
    requiredScrubSeconds: 15
    dryingSeconds: 10
    cleanRadius: 0.025
    requiredCoverage: 0.8
    tourniquetLimitSeconds: 120
    pressureSeconds: 3
  steps:
  - id: 0
    title: Hand hygiene & gloves
    instruction: Perform hand hygiene and put on clean gloves.
    hint: Use the glove box on the left of the table.
  - id: 1
    title: Apply tourniquet
    instruction: Apply the tourniquet above the intended site so the veins fill.
    hint: Use the blue tourniquet strip. Watch the veins become larger.
  - id: 2
    title: Palpate & select a vein
    instruction: Palpate the forearm to find a straight, bouncy vein away from joints
      and valves.
    hint: With an empty hand, press and hold on the skin over a vein for a second.
  - id: 3
    title: Clean the site
    instruction: Wet the swab with alcohol, then scrub the site with firm back-and-forth
      strokes.
    hint: Pick up the swab, touch it to the alcohol bottle, then rub the skin around
      your chosen site.
  - id: 4
    title: Let the skin dry
    instruction: Allow the antiseptic to dry completely. Do not touch or re-palpate
      the cleaned area.
    hint: Wait until the wet sheen has disappeared.
  - id: 5
    title: Insert the cannula
    instruction: Bevel up, enter the skin at a shallow 15-30 degree angle in line
      with the vein until you see flashback.
    hint: Watch the clear chamber at the back of the cannula for blood (flashback).
  - id: 6
    title: Lower the angle & advance 1-2 mm
    instruction: After flashback, lower the cannula almost flat to the skin and advance
      a further 1-2 mm so the catheter tip is inside the vein.
    hint: Reduce the angle first, then push in just a little.
  - id: 7
    title: Advance the catheter
    instruction: Hold the needle still and slide the plastic catheter off the needle
      into the vein up to the hub.
    hint: 'VR: squeeze the trigger. Desktop: hold F.'
  - id: 8
    title: Release the tourniquet
    instruction: Release the tourniquet before removing the needle.
    hint: Use the tourniquet on the arm again.
  - id: 9
    title: Withdraw the needle
    instruction: Occlude the vein above the catheter tip and withdraw the needle,
      leaving the catheter in place.
    hint: 'VR: pull your hand straight back. Desktop: hold X.'
  - id: 10
    title: Dispose of the needle
    instruction: Place the used needle immediately into the sharps container.
    hint: The yellow bin with the red lid.
  - id: 11
    title: Draw a blood sample
    instruction: Attach the syringe to the cannula hub and gently draw back to obtain
      a sample.
    hint: Use the syringe with the red label, then hold to draw.
  - id: 12
    title: Flush with saline
    instruction: Flush the cannula with 0.9% saline and check there is no swelling
      or pain (patency).
    hint: Use the saline syringe, then hold to push.
  - id: 13
    title: Secure with a dressing
    instruction: Apply a sterile transparent dressing over the cannula.
    hint: Use the dressing pack on the tray.
  - id: 14
    title: Remove the cannula
    instruction: 'When therapy is finished: remove the dressing and withdraw the
      catheter smoothly. Check the tip is intact.'
    hint: Use the cannula hub on the arm.
  - id: 15
    title: Apply pressure
    instruction: Place gauze over the site and apply firm pressure until bleeding
      stops.
    hint: 'Click the gauze (VR: touch + trigger) to place it, then HOLD on it until
      the bar fills.'
  skinTone: {r: 0.71, g: 0.52, b: 0.4, a: 1}
  arm: {fileID: 1443751002235412361}
  cleaning: {fileID: 1443751002235412360}
  cannula: {fileID: 8667343304633707937}
  skinOpaque: {fileID: 2100000, guid: ffb04bacf2988494fa97754b61b69d94, type: 2}
  skinTransparent: {fileID: 2100000, guid: b291dcaea7a42d74d92e9ee8cb38db46, type: 2}
  bloodMaterial: {fileID: 2100000, guid: f56378f7ae458454ab9d83006236ebe6, type: 2}
  hematomaMaterial: {fileID: 2100000, guid: a588510cc0f4a0e47a927b1292536637, type: 2}
  bruiseMaterial: {fileID: 2100000, guid: 6614bf9f10d988344872bba20ad21fba, type: 2}
  angleReferenceBoard: {fileID: 2108878472}
  ControlMode: Desktop
  HintsVisible: 1
